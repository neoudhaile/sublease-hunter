<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Daily scrape at 8:07am. Replace /path/to/sublease-hunter with your checkout,
     then: launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.example.sublease-hunter.plist -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.example.sublease-hunter</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/path/to/sublease-hunter/daily_run.sh</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict><key>Hour</key><integer>8</integer><key>Minute</key><integer>7</integer></dict>
    <key>StandardOutPath</key>
    <string>/path/to/sublease-hunter/logs/daily.log</string>
    <key>StandardErrorPath</key>
    <string>/path/to/sublease-hunter/logs/daily.log</string>
</dict>
</plist>
