# Copy to .env. Loaded automatically by the pipeline.

# Notion internal integration token: https://www.notion.so/my-integrations
# The integration must be shared with your parent page:
#   page ... menu -> Connections -> your integration
NOTION_TOKEN=

# Optional: Apify token for scraping public groups (console.apify.com).
# Groups with method: apify are skipped when this is unset.
APIFY_TOKEN=
